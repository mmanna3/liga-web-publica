# URL base de la API carnet-digital (solo server-side en build/SSR de Astro)
API_BASE_URL=https://admin.edefi.com.ar/api/carnet-digital

# Origen del backend para rutas públicas e imágenes (opcional; si no se define, se deriva de API_BASE_URL)
API_ORIGIN=https://admin.edefi.com.ar

# Procesamiento de escudos: npm run process-escudos (commitear public/escudos-processed/*.png al repo)
# Duplicados (mismo PNG): npm run dedupe-escudos  (preview: DRY_RUN=1 npm run dedupe-escudos)
# En CI: push a main usa build:gh-pages sin procesar; workflow manual "Deploy with escudo processing" sí.
# SKIP_ESCUDOS_PROCESS=1  — omitir solo en npm run process-escudos
# FORCE_ESCUDOS=1         — regenerar todos

# Sitio público (SEO, canonical, OG)
PUBLIC_SITE_URL=https://tu-usuario.github.io/liga-web-publica

# Nombre de la liga (visible en UI y meta)
PUBLIC_LIGA_NOMBRE=EDEFI

# URLs de las tiendas de apps (opcional App Store; Play Store tiene default)
PUBLIC_APP_STORE_URL=https://apps.apple.com/ar/app/edefi-delegados/id6480324679
PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.ykn.edefidelegados

# Base path: `/` en dev (`npm run dev`); `/liga-web-publica/` solo en `npm run build:gh-pages`
BASE_PATH=/
