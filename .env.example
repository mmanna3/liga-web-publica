# URL base de la API (solo server-side en build/SSR de Astro)
API_BASE_URL=https://admin.edefi.com.ar/api/carnet-digital

# Sitio público (SEO, canonical, OG)
PUBLIC_SITE_URL=https://tu-usuario.github.io/liga-web-publica

# Nombre de la liga (visible en UI y meta)
PUBLIC_LIGA_NOMBRE=EDEFI

# URLs de las tiendas de apps (opcional App Store; Play Store tiene default)
PUBLIC_APP_STORE_URL=https://apps.apple.com/ar/app/edefi-delegados/id6480324679
PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.ykn.edefidelegados

# Base path: `/` en dev (`npm run dev`); `/liga-web-publica/` solo en `npm run build:gh-pages`
BASE_PATH=/
