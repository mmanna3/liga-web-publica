---
import { assetUrl } from '@lib/paths';

interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg';
  /** En fondos oscuros: círculo blanco + sombra para que el PNG se lea bien */
  variant?: 'plain' | 'emblem';
}

const { class: className = '', size = 'md', variant = 'plain' } = Astro.props;

const wrapperSize = {
  sm: 'h-9 w-9',
  md: 'h-10 w-10',
  lg: 'h-20 w-20 sm:h-24 sm:w-24',
}[size];
---

{
  variant === 'emblem' ? (
    <span
      class:list={[
        'inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full bg-white',
        'shadow-[0_0_0_0.5px_#fff,0_2px_16px_rgb(0_0_0/0.45)]',
        'transition-all duration-300',
        'group-hover:scale-105',
        'group-hover:shadow-[0_0_0_0.5px_#fff,0_4px_24px_rgb(255_255_255/0.15)]',
        wrapperSize,
        className,
      ]}
    >
      <img
        src={assetUrl('logo.png')}
        alt="Encuentro Deportivo de Fútbol Infantil"
        width="96"
        height="96"
        class="h-full w-full object-contain"
        loading="eager"
        decoding="async"
      />
    </span>
  ) : (
    <img
      src={assetUrl('logo.png')}
      alt="Encuentro Deportivo de Fútbol Infantil"
      width="80"
      height="80"
      class:list={['object-contain', className]}
      loading="eager"
      decoding="async"
    />
  )
}
