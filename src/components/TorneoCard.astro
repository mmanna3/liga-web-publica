---
import type { Torneo } from '@types/torneo';
import Card from '@components/ui/Card.astro';
import Icon from '@components/ui/Icon.astro';
import FaseCard from '@components/FaseCard.astro';

interface Props {
  torneo: Torneo;
  accentClass?: string;
  pillHoverClass?: string;
}

const { torneo, accentClass, pillHoverClass } = Astro.props;
---

<Card>
  <div class="flex items-center gap-3">
    <span
      class:list={[
        'flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/5',
        accentClass,
      ]}
      aria-hidden="true"
    >
      <Icon name="trophy" size="md" />
    </span>
    <h3 class="font-display text-2xl tracking-wide text-white uppercase sm:text-3xl">
      {torneo.nombre}
    </h3>
  </div>

  <div class="mt-6 space-y-4">
    {torneo.fases.map((fase) => (
      <FaseCard fase={fase} accentClass={accentClass} pillHoverClass={pillHoverClass} />
    ))}
  </div>
</Card>
