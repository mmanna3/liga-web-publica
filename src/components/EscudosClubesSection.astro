---
import type { EscudoClubDisplay } from '@lib/escudos';

interface Props {
  escudos: EscudoClubDisplay[];
  variant?: 'dark' | 'light' | 'light-grunge';
  roundedEscudos?: boolean;
}

const { escudos, variant = 'dark', roundedEscudos = false } = Astro.props;
const isLight = variant === 'light' || variant === 'light-grunge';
const isLightGrunge = variant === 'light-grunge';

function shuffle<T>(items: T[]): T[] {
  const copy = [...items];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

/** ~4s por escudo en el carrusel (sponsors ~10 → 40s). */
const escudosMezclados = shuffle(escudos);
const scrollDurationSec = Math.max(180, Math.round(escudos.length * 4));
---

{
  escudos.length > 0 && (
    <section
      class:list={[
        'escudos-bar py-5 sm:py-6',
        isLightGrunge
          ? 'escudos-bar--light-grunge relative overflow-hidden border-b border-[#0a0a0b]'
          : isLight
            ? 'border-b border-[#0a0a0b]/10 bg-white'
            : 'border-b border-white/5 bg-surface',
      ]}
      aria-label="Clubes de la liga"
    >
      {isLightGrunge && (
        <div class="escudos-bar__decor-grunge pointer-events-none absolute inset-0 z-0" aria-hidden="true" />
      )}

      <p
        class:list={[
          'font-display relative z-10 mb-5 text-center text-[10px] tracking-[0.35em] uppercase',
          isLightGrunge
            ? 'escudos-bar__title-grunge text-[#0a0a0b]'
            : isLight
              ? 'text-[#0a0a0b]/55'
              : 'text-zinc-500',
        ]}
      >
        Clubes de la liga
      </p>

      <div class="escudos-marquee relative z-10">
        <div
          class="escudos-track"
          style={`--escudos-duration: ${scrollDurationSec}s`}
        >
          {[...escudosMezclados, ...escudosMezclados].map((club) => (
            <div class="escudos-item" title={club.nombre}>
              {roundedEscudos ? (
                <span class="escudo-frame">
                  <img
                    src={club.imgSrc}
                    alt={`Escudo de ${club.nombre}`}
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              ) : (
                <img
                  src={club.imgSrc}
                  alt={`Escudo de ${club.nombre}`}
                  width="48"
                  height="48"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
          ))}
        </div>
      </div>

      {isLightGrunge && (
        <div class="escudos-bar__decor-shapes pointer-events-none absolute inset-0 z-20" aria-hidden="true" />
      )}
    </section>
  )
}
