---
import { siteConfig } from '@lib/site';
import { assetUrl } from '@lib/paths';

const heroImages = [
  assetUrl('imagenes-home/1.jpeg'),
  assetUrl('imagenes-home/2.jpeg'),
  assetUrl('imagenes-home/3.jpeg'),
  assetUrl('imagenes-home/4.jpeg'),
];
---

<section class="relative flex min-h-[90vh] items-center overflow-hidden pt-16">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="hero-bg-carousel">
      {
        heroImages.map((src, index) => (
          <img
            src={src}
            alt=""
            width="1920"
            height="1080"
            class="hero-bg-slide"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        ))
      }
    </div>

    <div class="absolute inset-0 bg-emerald-950/55 mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-surface/45"></div>

    <div
      class="absolute inset-0 bg-[linear-gradient(105deg,rgb(10_10_11/0.92)_0%,rgb(10_10_11/0.72)_42%,rgb(10_10_11/0.25)_72%,transparent_100%)]"
    >
    </div>

    <div
      class="absolute inset-0 bg-[linear-gradient(to_bottom,transparent_0%,transparent_55%,var(--color-surface)_100%)]"
    >
    </div>

    <div
      class="absolute -top-24 left-0 h-[420px] w-[520px] rounded-full bg-accent-hot/15 blur-[100px]"
    >
    </div>

    <div class="noise-overlay absolute inset-0 opacity-25"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
    <p
      class="font-display animate-fade-up mb-4 flex items-center gap-2 text-xs tracking-[0.35em] text-accent-hot uppercase"
    >
      EDEFI
    </p>

    <h1
      class="font-display animate-fade-up stagger-1 max-w-4xl text-6xl leading-[1.05] tracking-wide uppercase drop-shadow-[0_2px_24px_rgb(0_0_0/0.45)] sm:text-7xl md:text-8xl lg:text-9xl"
    >
      <span class="text-gradient-hero">El fútbol</span>
      <br />
      <span class="text-white">se vive acá</span>
    </h1>

    <p
      class="animate-fade-up stagger-2 mt-8 max-w-xl text-lg leading-relaxed text-zinc-300 sm:text-xl"
    >
      {siteConfig.descripcion}
    </p>

    <div id="hero-agrupadores-nav" class="animate-fade-up stagger-3 mt-10 min-h-[52px]">
      <div class="animate-pulse-soft flex flex-wrap gap-4">
        <div class="h-12 w-36 rounded-full bg-white/10"></div>
        <div class="h-12 w-40 rounded-full bg-white/10"></div>
      </div>
    </div>

    <div id="hero-stats" class="mt-16 min-h-[120px]"></div>
  </div>

  <div
    class="pointer-events-none absolute bottom-8 left-1/2 z-10 -translate-x-1/2 animate-pulse-soft"
    aria-hidden="true"
  >
    <div class="h-12 w-px bg-linear-to-b from-white/40 to-transparent"></div>
  </div>
</section>
