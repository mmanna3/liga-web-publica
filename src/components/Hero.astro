---
import { siteConfig } from '@lib/site';
import Icon from '@components/ui/Icon.astro';
import { assetUrl } from '@lib/paths';
import { getAgrupadorTheme } from '@lib/colors';
import type { AgrupadorDeTorneo } from '@types/torneo';

interface Props {
  agrupadores?: AgrupadorDeTorneo[];
  totalAgrupadores?: number;
  totalTorneos?: number;
}

const { agrupadores = [], totalAgrupadores = 0, totalTorneos = 0 } = Astro.props;
const heroImages = [
  { src: assetUrl('from-ball-white-line.jpg'), position: 'hero-bg-slide--ball' },
  { src: assetUrl('mate.png'), position: 'hero-bg-slide--mate' },
  { src: assetUrl('persona-edefi.jpg'), position: 'hero-bg-slide--persona' },
];
---

<section class="relative flex min-h-[90vh] items-center overflow-hidden pt-16">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="hero-bg-carousel">
      {
        heroImages.map((image, index) => (
          <img
            src={image.src}
            alt=""
            width="1920"
            height="1080"
            class:list={['hero-bg-slide', image.position]}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding="async"
          />
        ))
      }
    </div>

    <!-- Tinte verde + oscurecido general -->
    <div class="absolute inset-0 bg-emerald-950/55 mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-surface/45"></div>

    <!-- Legibilidad del copy: más oscuro a la izquierda -->
    <div
      class="absolute inset-0 bg-[linear-gradient(105deg,rgb(10_10_11/0.92)_0%,rgb(10_10_11/0.72)_42%,rgb(10_10_11/0.25)_72%,transparent_100%)]"
    >
    </div>

    <!-- Transición suave hacia la siguiente sección -->
    <div
      class="absolute inset-0 bg-[linear-gradient(to_bottom,transparent_0%,transparent_55%,var(--color-surface)_100%)]"
    >
    </div>

    <!-- Brillo verde sutil del lado del texto -->
    <div
      class="absolute -top-24 left-0 h-[420px] w-[520px] rounded-full bg-accent-hot/15 blur-[100px]"
    >
    </div>

    <div class="noise-overlay absolute inset-0 opacity-25"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
    <p
      class="font-display animate-fade-up mb-4 flex items-center gap-2 text-xs tracking-[0.35em] text-accent-hot uppercase"
    >
      <!-- <Icon name="calendar" size="sm" /> -->
      EDEFI
    </p>

    <h1
      class="font-display animate-fade-up stagger-1 max-w-4xl text-6xl leading-[1.05] tracking-wide uppercase drop-shadow-[0_2px_24px_rgb(0_0_0/0.45)] sm:text-7xl md:text-8xl lg:text-9xl"
    >
      <span class="text-gradient-hero">El fútbol</span>
      <br />
      <span class="text-white">se vive acá</span>
    </h1>

    <p
      class="animate-fade-up stagger-2 mt-8 max-w-xl text-lg leading-relaxed text-zinc-300 sm:text-xl"
    >
      {siteConfig.descripcion}
    </p>

    {
      agrupadores.length > 0 && (
        <ul class="animate-fade-up stagger-3 mt-10 flex flex-wrap items-center gap-4 sm:gap-6">
          {agrupadores.map((a) => {
            const theme = getAgrupadorTheme(a.color);
            return (
              <li>
                <a
                  href={`#agrupador-${a.id}`}
                  class:list={[
                    'glass glass-hover flex items-center gap-3 rounded-full px-6 py-3 transition-all duration-300',
                    theme.border,
                  ]}
                >
                  <span
                    class:list={[
                      'flex h-9 w-9 items-center justify-center rounded-full bg-white/5',
                      theme.accent,
                    ]}
                    aria-hidden="true"
                  >
                    <Icon name="ball" size="sm" />
                  </span>
                  <span class="font-display text-lg tracking-wide text-white uppercase">
                    {a.nombre}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }

    {
      totalAgrupadores > 0 && (
        <dl class="animate-fade-up stagger-4 mt-16 grid grid-cols-2 gap-6 border-t border-white/15 pt-10 sm:grid-cols-3 sm:gap-10">
          <div class="text-center">
            <dt class="font-display flex items-center justify-center gap-2 text-[10px] tracking-[0.2em] text-zinc-400 uppercase">
              <Icon name="shield" size="sm" class="text-accent-hot" />
              Equipos
            </dt>
            <dd class="font-display mt-1 text-4xl text-white sm:text-5xl">+500</dd>
          </div>
          <div class="text-center">
            <dt class="font-display flex items-center justify-center gap-2 text-[10px] tracking-[0.2em] text-zinc-400 uppercase">
              <Icon name="trophy" size="sm" class="text-accent-hot" />
              Torneos
            </dt>
            <dd class="font-display mt-1 text-4xl text-white sm:text-5xl">{totalTorneos}</dd>
          </div>
          <div class="col-span-2 text-center sm:col-span-1">
            <dt class="font-display flex items-center justify-center gap-2 text-[10px] tracking-[0.2em] text-zinc-400 uppercase">
              <Icon name="calendar" size="sm" class="text-accent-hot" />
              Partidos
            </dt>
            <dd class="font-display mt-1 text-4xl text-white sm:text-5xl">+12000</dd>
          </div>
        </dl>
      )
    }
  </div>

  <div
    class="pointer-events-none absolute bottom-8 left-1/2 z-10 -translate-x-1/2 animate-pulse-soft"
    aria-hidden="true"
  >
    <div class="h-12 w-px bg-linear-to-b from-white/40 to-transparent"></div>
  </div>
</section>
