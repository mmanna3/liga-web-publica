---
import { siteConfig } from '@lib/site';
import BrandName from '@components/BrandName.astro';

interface Props {
  totalAgrupadores?: number;
  totalTorneos?: number;
}

const { totalAgrupadores = 0, totalTorneos = 0 } = Astro.props;
---

<section class="relative flex min-h-[90vh] items-center overflow-hidden pt-16">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-1/4 left-1/2 h-[600px] w-[900px] -translate-x-1/2 rounded-full bg-accent-hot/20 blur-[120px]"
    >
    </div>
    <div
      class="absolute right-0 bottom-0 h-[400px] w-[500px] rounded-full bg-accent-cool/10 blur-[100px]"
    >
    </div>
    <div class="noise-overlay absolute inset-0 opacity-40"></div>
    <div
      class="absolute inset-0 bg-[linear-gradient(to_bottom,transparent_0%,var(--color-surface)_85%)]"
    >
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-4 py-24 sm:px-6 sm:py-32 lg:px-8">
    <p
      class="font-display animate-fade-up mb-4 text-xs tracking-[0.35em] text-accent-hot uppercase"
    >
      Temporada en curso
    </p>

    <h1
      class="font-display animate-fade-up stagger-1 max-w-4xl text-6xl leading-[0.9] tracking-wide uppercase sm:text-7xl md:text-8xl lg:text-9xl"
    >
      <span class="text-gradient-hero">El fútbol</span>
      <br />
      <span class="text-white">se vive acá</span>
    </h1>

    <p
      class="animate-fade-up stagger-2 mt-8 max-w-xl text-lg leading-relaxed text-zinc-400 sm:text-xl"
    >
      {siteConfig.descripcion}
    </p>

    <div class="animate-fade-up stagger-3 mt-10 flex flex-wrap gap-4">
      <a
        href="#torneos"
        class="font-display inline-flex items-center gap-2 rounded-full bg-accent-hot px-8 py-3.5 text-sm tracking-widest text-white uppercase transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-accent-hot/30"
      >
        Explorar torneos
        <svg
          class="h-4 w-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
      <a
        href="#categorias"
        class="font-display glass glass-hover inline-flex items-center rounded-full px-8 py-3.5 text-sm tracking-widest text-zinc-300 uppercase"
      >
        Categorías
      </a>
    </div>

    {
      totalAgrupadores > 0 && (
        <dl class="animate-fade-up stagger-4 mt-16 grid grid-cols-2 gap-6 border-t border-white/10 pt-10 sm:grid-cols-3 sm:gap-10">
          <div>
            <dt class="font-display text-[10px] tracking-[0.2em] text-zinc-500 uppercase">
              Categorías
            </dt>
            <dd class="font-display mt-1 text-4xl text-white sm:text-5xl">{totalAgrupadores}</dd>
          </div>
          <div>
            <dt class="font-display text-[10px] tracking-[0.2em] text-zinc-500 uppercase">
              Torneos
            </dt>
            <dd class="font-display mt-1 text-4xl text-white sm:text-5xl">{totalTorneos}</dd>
          </div>
          <div class="col-span-2 sm:col-span-1">
            <dt class="font-display text-[10px] tracking-[0.2em] text-zinc-500 uppercase">Liga</dt>
            <dd class="mt-1 text-4xl text-accent-cool sm:text-5xl">
              <BrandName />
            </dd>
          </div>
        </dl>
      )
    }
  </div>

  <div
    class="pointer-events-none absolute bottom-8 left-1/2 -translate-x-1/2 animate-pulse-soft"
    aria-hidden="true"
  >
    <div class="h-12 w-px bg-linear-to-b from-white/40 to-transparent"></div>
  </div>
</section>
