---
import type { IconName } from '@types/icon';
import { getIconShapes } from '@lib/icon-shapes';

interface Props {
  name: IconName;
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
}

const { name, class: className, size = 'md' } = Astro.props;

const sizeClass = {
  sm: 'h-4 w-4',
  md: 'h-5 w-5',
  lg: 'h-6 w-6',
  xl: 'h-10 w-10',
}[size];

const shapes = getIconShapes(name);
---

<svg
  class:list={[sizeClass, 'block shrink-0', className]}
  fill="none"
  viewBox="0 0 24 24"
  stroke="currentColor"
  stroke-width="1.75"
  aria-hidden="true"
>
  {
    shapes.map((shape) =>
      shape.type === 'circle' ? (
        <circle cx={shape.cx} cy={shape.cy} r={shape.r} />
      ) : (
        <path
          d={shape.d}
          stroke-linecap={shape.linecap}
          stroke-linejoin={shape.linejoin}
        />
      ),
    )
  }
</svg>
