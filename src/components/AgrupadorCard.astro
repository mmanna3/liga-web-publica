---
import type { AgrupadorDeTorneo } from '@types/torneo';
import { getAgrupadorTheme } from '@lib/colors';
import BallDecor from '@components/ui/BallDecor.astro';
import Icon from '@components/ui/Icon.astro';
import TorneoCard from '@components/TorneoCard.astro';

interface Props {
  agrupador: AgrupadorDeTorneo;
  index?: number;
}

const { agrupador, index = 0 } = Astro.props;
const theme = getAgrupadorTheme(agrupador.color);
const staggerClass = `stagger-${Math.min(index + 1, 4)}`;
---

<article
  id={`agrupador-${agrupador.id}`}
  class:list={[
    'animate-fade-up relative scroll-mt-28 overflow-hidden rounded-3xl border p-6 sm:p-8 md:p-10',
    theme.border,
    theme.glow,
    'shadow-2xl transition-shadow duration-500 hover:shadow-[0_24px_80px_-12px_rgba(0,0,0,0.6)]',
    staggerClass,
  ]}
>
  <div
    class:list={['pointer-events-none absolute inset-0 bg-linear-to-br opacity-60', theme.gradient]}
    aria-hidden="true"
  >
  </div>
  <div class="noise-overlay pointer-events-none absolute inset-0 opacity-30" aria-hidden="true">
  </div>

  <BallDecor
    class:list={[
      'absolute -right-4 -top-4 h-40 w-40 opacity-[0.12] sm:h-52 sm:w-52',
    ]}
  />

  <header
    class="relative z-10 mb-10 flex flex-wrap items-end justify-between gap-4 border-b border-white/10 pb-8"
  >
    <div class="flex items-start gap-4">
      <span
        class:list={[
          'flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border bg-white/5',
          theme.border,
          theme.accent,
        ]}
        aria-hidden="true"
      >
        <Icon name="trophy" size="lg" />
      </span>
      <h3
        class="font-display text-4xl leading-none tracking-wide text-white uppercase sm:text-5xl md:text-6xl"
      >
        {agrupador.nombre}
      </h3>
    </div>
    <span class="glass inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-sm font-medium text-zinc-400">
      <Icon name="trophy" size="sm" class={theme.accent} />
      {agrupador.torneos.length} torneos
    </span>
  </header>

  <div class="relative z-10 grid gap-6 lg:grid-cols-2">
    {agrupador.torneos.map((torneo) => (
      <TorneoCard
        torneo={torneo}
        accentClass={theme.accent}
        pillHoverClass={theme.pillHover}
      />
    ))}
  </div>
</article>
