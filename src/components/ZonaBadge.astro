---
import Icon from '@components/ui/Icon.astro';
import { formatZonaNombre } from '@lib/html-utils';

interface Props {
  nombre: string;
  accentClass?: string;
  pillHoverClass?: string;
}

const { nombre, accentClass, pillHoverClass } = Astro.props;
const nombreDisplay = formatZonaNombre(nombre);
---

<span
  class:list={[
    'group inline-flex cursor-default items-center gap-3 rounded-full border border-border-glass bg-white/5 px-5 py-2.5 backdrop-blur-xl',
    'font-display text-base font-medium tracking-wide text-zinc-300 uppercase',
    'transition-all duration-300 ease-out',
    'hover:scale-[1.05] hover:-translate-y-1 hover:text-white',
    pillHoverClass ??
      'hover:border-white/50 hover:bg-white/20 hover:shadow-lg hover:shadow-white/25',
  ]}
>
  <span
    class:list={[
      'flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/5 transition-all duration-300',
      'group-hover:scale-110 group-hover:bg-white/20',
      accentClass ?? 'text-zinc-400',
    ]}
    aria-hidden="true"
  >
    <Icon name="ball" size="sm" />
  </span>
  {nombreDisplay}
</span>
