---
import type { AgrupadorDeTorneo } from '@types/torneo';
import SectionHeading from '@components/ui/SectionHeading.astro';
import AgrupadorCard from '@components/AgrupadorCard.astro';

interface Props {
  agrupadores: AgrupadorDeTorneo[];
  error?: string | null;
}

const { agrupadores, error } = Astro.props;
---

<section id="torneos" class="scroll-mt-24 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Competencias"
      title="Torneos"
      description="Explorá torneos y zonas de la liga. Datos en tiempo real."
    />

    {
      error ? (
        <div
          class="glass animate-fade-in rounded-2xl border border-red-500/30 bg-red-950/20 p-8 text-center"
          role="alert"
        >
          <p class="font-display text-2xl tracking-wide text-red-400 uppercase">
            No se pudo cargar
          </p>
          <p class="mt-2 text-zinc-400">{error}</p>
        </div>
      ) : agrupadores.length === 0 ? (
        <div class="glass animate-fade-in rounded-2xl p-12 text-center">
          <p class="text-zinc-500">No hay torneos publicados en este momento.</p>
        </div>
      ) : (
        <div class="space-y-12 md:space-y-16">
          {agrupadores.map((agrupador, index) => (
            <AgrupadorCard agrupador={agrupador} index={index} />
          ))}
        </div>
      )
    }
  </div>
</section>
