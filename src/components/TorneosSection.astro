---
import SectionHeading from '@components/ui/SectionHeading.astro';
import LoadingSkeleton from '@components/ui/LoadingSkeleton.astro';
import { assetUrl } from '@lib/paths';

const sectionBgImage = assetUrl('from-ball-white-line.jpg');
---

<section id="torneos" class="relative scroll-mt-24 overflow-hidden py-20 sm:py-28">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <img
      src={sectionBgImage}
      alt=""
      width="1920"
      height="1080"
      class="absolute -right-[20%] top-1/2 h-[70%] max-h-[600px] w-auto -translate-y-1/2 object-cover opacity-[0.06] mix-blend-screen"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeading
      eyebrow="Competencias"
      title="Torneos"
      description="Explorá torneos y zonas de la liga. Datos en tiempo real."
      icon="trophy"
    />

    <div id="torneos-root" class="min-h-[200px]">
      <div class="glass rounded-2xl p-8">
        <LoadingSkeleton lines={5} />
      </div>
    </div>
  </div>
</section>
