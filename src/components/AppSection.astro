---
import Icon from '@components/ui/Icon.astro';
import { siteConfig } from '@lib/site';
import { assetUrl } from '@lib/paths';

const screenImage = assetUrl('screen.png');
const { appStoreUrl, playStoreUrl } = siteConfig;
---

<section id="app" class="relative scroll-mt-24 overflow-hidden border-y border-white/5 py-16 sm:py-24">
  <div
    class="pointer-events-none absolute -right-24 top-1/2 h-96 w-96 -translate-y-1/2 rounded-full bg-accent-hot/10 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="animate-fade-up order-2 text-center lg:order-1 lg:text-left">
        <p
          class="font-display mb-4 flex items-center justify-center gap-2 text-xs tracking-[0.3em] text-accent-hot uppercase lg:justify-start"
        >
          <Icon name="smartphone" size="sm" />
          App móvil
        </p>

        <h2
          class="font-display text-4xl leading-none tracking-wide text-white uppercase sm:text-5xl md:text-6xl"
        >
          Bajate la app
        </h2>

        <p class="mt-6 max-w-lg text-lg leading-relaxed text-zinc-400 lg:mx-0 mx-auto">
          Fichaje de jugadores, resultados de partidos y panel de delegados. Disponible para iOS y Android.
        </p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-4 lg:justify-start">
          <a
            href={appStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 rounded-xl border border-white/10 bg-zinc-900 px-5 py-3 text-white transition-all duration-300 hover:scale-[1.02] hover:border-white/20 hover:bg-zinc-800 hover:shadow-lg"
            aria-label="Descargar en App Store"
          >
            <svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z" />
            </svg>
            <span class="text-left leading-tight">
              <span class="block text-[10px] tracking-wide opacity-80">Descargá en</span>
              <span class="block text-lg font-semibold tracking-tight">App Store</span>
            </span>
          </a>

          <a
            href={playStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 rounded-xl border border-white/10 bg-zinc-900 px-5 py-3 text-white transition-all duration-300 hover:scale-[1.02] hover:border-white/20 hover:bg-zinc-800 hover:shadow-lg"
            aria-label="Descargar en Google Play"
          >
            <svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M3.609 1.814L13.792 12 3.61 22.186a1.003 1.003 0 01-1.569-.806V2.62a1.003 1.003 0 011.568-.806zM14.5 12.707l2.302 2.302-10.937 6.333 8.635-8.635zM16.792 10.415L20.98 8.001a1.003 1.003 0 010 1.732l-4.188 2.414-2.302-2.302 2.302-2.43zM14.5 11.293L5.865 2.658l10.937 6.333L14.5 11.293z" />
            </svg>
            <span class="text-left leading-tight">
              <span class="block text-[10px] tracking-wide opacity-80">Disponible en</span>
              <span class="block text-lg font-semibold tracking-tight">Google Play</span>
            </span>
          </a>
        </div>
      </div>

      <div class="animate-fade-up stagger-1 order-1 flex justify-center lg:order-2">
        <img
          src={screenImage}
          alt="Captura de la app EDEFI en un teléfono"
          width="640"
          height="640"
          class="w-full max-w-md drop-shadow-[0_24px_48px_rgb(0_0_0/0.45)] sm:max-w-lg lg:max-w-xl"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
