---
import type { Fase } from '@types/torneo';
import Card from '@components/ui/Card.astro';
import ZonaBadge from '@components/ZonaBadge.astro';

interface Props {
  fase: Fase;
  accentClass?: string;
}

const { fase, accentClass } = Astro.props;
---

<Card class="border-l-2 border-l-white/10" hover={false}>
  <h4 class="font-display text-xl tracking-wide text-white uppercase">{fase.nombre}</h4>

  {
    fase.zonas.length > 0 ? (
      <div class="mt-4">
        <p
          class:list={[
            'mb-2 inline-block text-[10px] font-bold tracking-[0.3em] uppercase',
            accentClass ?? 'text-zinc-500',
          ]}
        >
          Zonas
        </p>
        <div class="flex flex-wrap gap-2">
          {fase.zonas.map((zona) => (
            <ZonaBadge nombre={zona.nombre} />
          ))}
        </div>
      </div>
    ) : (
      <p class="mt-3 text-sm text-zinc-600 italic">Sin zonas asignadas</p>
    )
  }
</Card>
