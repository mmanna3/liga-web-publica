---
import type { AgrupadorDeTorneo } from '@types/torneo';
import { getAgrupadorTheme } from '@lib/colors';
import BallDecor from '@components/ui/BallDecor.astro';
import Icon from '@components/ui/Icon.astro';

interface Props {
  agrupadores: AgrupadorDeTorneo[];
}

const { agrupadores } = Astro.props;
---

{
  agrupadores.length > 0 && (
    <section id="competencias" class="relative scroll-mt-24 overflow-hidden border-y border-white/5 py-16">
      <BallDecor
        class="absolute -right-6 top-1/2 h-32 w-32 -translate-y-1/2 opacity-[0.06]"
      />
      <BallDecor
        class="absolute -left-6 top-1/2 h-32 w-32 -translate-y-1/2 opacity-[0.06]"
      />
      <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="font-display mb-8 flex items-center justify-center gap-2 text-xs tracking-[0.3em] text-zinc-500 uppercase">
          <Icon name="grid" size="sm" />
          Competencias
        </p>
        <ul class="flex flex-wrap items-center justify-center gap-4 sm:gap-6">
          {agrupadores.map((a) => {
            const theme = getAgrupadorTheme(a.color);
            return (
              <li>
                <a
                  href="#torneos"
                  class:list={[
                    'glass glass-hover flex items-center gap-3 rounded-full px-6 py-3 transition-all duration-300',
                    theme.border,
                  ]}
                >
                  <span
                    class:list={[
                      'flex h-9 w-9 items-center justify-center rounded-full bg-white/5',
                      theme.accent,
                    ]}
                    aria-hidden="true"
                  >
                    <Icon name="ball" size="sm" />
                  </span>
                  <span class="font-display text-lg tracking-wide text-white uppercase">
                    {a.nombre}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}
