---
import Logo from '@components/Logo.astro';
import Card from '@components/ui/Card.astro';
import Icon from '@components/ui/Icon.astro';
import { googleMapsSearchUrl } from '@lib/html-utils';
import { siteConfig } from '@lib/site';

const { contacto, redes } = siteConfig;
const direccionCompleta = `${contacto.direccion} (CP ${contacto.cp})`;
const mapsUrl = googleMapsSearchUrl(direccionCompleta);
---

<section id="contacto" class="relative scroll-mt-24 overflow-hidden border-t border-white/5 py-20 sm:py-28">
  <div
    class="pointer-events-none absolute -right-24 top-1/3 h-96 w-96 rounded-full bg-accent-cool/5 blur-[120px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <header class="mx-auto mb-12 max-w-3xl animate-fade-up text-center">
      <p
        class="font-display mb-3 flex items-center justify-center gap-2 text-xs tracking-[0.25em] text-accent-hot uppercase"
      >
        <Logo size="sm" variant="emblem" />
        EDEFI
      </p>
      <h2
        class="font-display text-4xl leading-none tracking-wide text-white uppercase sm:text-5xl md:text-6xl"
      >
        Contacto
      </h2>
    </header>

    <div class="animate-fade-up mx-auto grid max-w-4xl gap-6 sm:grid-cols-2">
      <Card hover={false} class="stagger-1">
        <div class="mb-4 flex items-center gap-3">
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/5"
            aria-hidden="true"
          >
            <Icon name="calendar" size="md" class="text-accent-hot" />
          </span>
          <h3 class="font-display text-xl tracking-wide text-accent-hot uppercase sm:text-2xl">
            Horario de atención
          </h3>
        </div>
        <div class="space-y-2 text-base leading-relaxed text-zinc-400">
          {
            contacto.horarios.map((horario) => (
              <p>{horario}</p>
            ))
          }
        </div>
      </Card>

      <Card hover={false} class="stagger-2">
        <div class="mb-4 flex items-center gap-3">
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/5"
            aria-hidden="true"
          >
            <Icon name="map-pin" size="md" class="text-accent-hot" />
          </span>
          <h3 class="font-display text-xl tracking-wide text-accent-hot uppercase sm:text-2xl">
            Dirección
          </h3>
        </div>
        <p class="text-sm leading-5">
          <a
            href={mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-start gap-1.5 text-accent-hot underline-offset-2 transition-colors hover:text-white hover:underline"
            aria-label={`Ver ${direccionCompleta} en Google Maps`}
          >
            <Icon name="map-pin" size="sm" class="translate-y-0.5" />
            <span>{direccionCompleta}</span>
          </a>
        </p>
      </Card>

      <Card hover={false} class="stagger-3">
        <div class="mb-4 flex items-center gap-3">
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/5"
            aria-hidden="true"
          >
            <Icon name="mobile-phone" size="md" class="text-accent-hot" />
          </span>
          <h3 class="font-display text-xl tracking-wide text-accent-hot uppercase sm:text-2xl">
            Teléfono
          </h3>
        </div>
        <p class="text-base leading-relaxed text-zinc-400">
          <a href={`tel:${contacto.telefono}`} class="transition-colors hover:text-white">
            {contacto.telefonoDisplay}
          </a>
        </p>
      </Card>

      <Card hover={false} class="stagger-4">
        <div class="mb-4 flex items-center gap-3">
          <span
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-white/5"
            aria-hidden="true"
          >
            <Icon name="mail" size="md" class="text-accent-hot" />
          </span>
          <h3 class="font-display text-xl tracking-wide text-accent-hot uppercase sm:text-2xl">
            E-mail
          </h3>
        </div>
        <p class="text-base leading-relaxed text-zinc-400">
          <a href={`mailto:${contacto.email}`} class="transition-colors hover:text-white">
            {contacto.email}
          </a>
        </p>
      </Card>
    </div>

    <div class="animate-fade-up stagger-4 mt-12 text-center">
      <p class="font-display mb-6 text-sm tracking-[0.2em] text-zinc-500 uppercase">Seguinos</p>
      <div class="flex items-center justify-center gap-5">
        <a
          href={redes.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-transform duration-200 hover:scale-110 active:scale-95"
          aria-label="Instagram de EDEFI"
        >
          <svg class="h-10 w-10" viewBox="0 0 24 24" aria-hidden="true">
            <defs>
              <linearGradient id="instagram-gradient" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#feda75"></stop>
                <stop offset="25%" stop-color="#fa7e1e"></stop>
                <stop offset="50%" stop-color="#d62976"></stop>
                <stop offset="75%" stop-color="#962fbf"></stop>
                <stop offset="100%" stop-color="#4f5bd5"></stop>
              </linearGradient>
            </defs>
            <path
              fill="url(#instagram-gradient)"
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
            ></path>
          </svg>
        </a>

        <a
          href={redes.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="transition-transform duration-200 hover:scale-110 active:scale-95"
          aria-label="Facebook de EDEFI"
        >
          <svg class="h-10 w-10" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="#1877F2"
              d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
            ></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
