---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import NosotrosSection from '@components/NosotrosSection.astro';
import ContactoSection from '@components/ContactoSection.astro';
import AppSection from '@components/AppSection.astro';
import SponsorsSection from '@components/SponsorsSection.astro';
import EscudosClubesSection from '@components/EscudosClubesSection.astro';
import AgrupadoresNav from '@components/AgrupadoresNav.astro';
import TorneosSection from '@components/TorneosSection.astro';
import { getAgrupadoresDeTorneo, ApiError } from '@lib/api';
import { getEscudosProcesadosParaUi } from '@lib/escudos';
import type { EscudoClubDisplay } from '@lib/escudos';
import type { AgrupadorDeTorneo } from '@types/torneo';

let agrupadores: AgrupadorDeTorneo[] = [];
let escudos: EscudoClubDisplay[] = [];
let fetchError: string | null = null;

try {
  agrupadores = await getAgrupadoresDeTorneo();
} catch (error) {
  fetchError =
    error instanceof ApiError ? error.message : 'Ocurrió un error inesperado al cargar los torneos';
}

escudos = await getEscudosProcesadosParaUi();

const totalTorneos = agrupadores.reduce((acc, a) => acc + a.torneos.length, 0);
---

<BaseLayout>
  <Hero totalAgrupadores={agrupadores.length} totalTorneos={totalTorneos} />
  <SponsorsSection />
  <EscudosClubesSection escudos={escudos} />
  <AppSection />
  <AgrupadoresNav agrupadores={agrupadores} />
  <TorneosSection agrupadores={agrupadores} error={fetchError} />
  <NosotrosSection />
  <ContactoSection />
</BaseLayout>
