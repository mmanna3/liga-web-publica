---
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import ContactoSection from '@components/ContactoSection.astro';
import AppSection from '@components/AppSection.astro';
import SponsorsSection from '@components/SponsorsSection.astro';
import EscudosClubesSection from '@components/EscudosClubesSection.astro';
import TorneosSection from '@components/TorneosSection.astro';
import { getEscudosDeApiParaUi, getEscudosProcesadosParaUi } from '@lib/escudos';
import { getSponsorsWebPublica } from '@lib/api';

const showEscudosClubesSection = false;

const [escudos, escudosApi, sponsors] = await Promise.all([
  showEscudosClubesSection ? getEscudosProcesadosParaUi() : Promise.resolve([]),
  showEscudosClubesSection ? getEscudosDeApiParaUi() : Promise.resolve([]),
  getSponsorsWebPublica().catch(() => []),
]);
---

<BaseLayout>
  <Hero />
  <SponsorsSection sponsors={sponsors} />
  {
    showEscudosClubesSection && (
      <>
        <EscudosClubesSection escudos={escudos} />
        <EscudosClubesSection escudos={escudosApi} variant="light" />
        <EscudosClubesSection escudos={escudosApi} variant="light-grunge" />
        <EscudosClubesSection escudos={escudosApi} roundedEscudos />
      </>
    )
  }
  <AppSection />
  <TorneosSection />
  <ContactoSection />
</BaseLayout>

<script>
  import '../scripts/home-torneos.ts';
</script>
